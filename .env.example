# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit secrets or API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Google Maps ─────────────────────────────────────────────────────────────
#
# Used for the embedded map on each business detail page.
# How to get a key:
#   1. Google Cloud Console → APIs & Services → Credentials → Create API Key
#   2. Enable "Maps Embed API" for the project
#   3. Restrict the key to your domain (recommended)
#   4. NEXT_PUBLIC_ prefix makes it available to the browser bundle

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_EMBED_API_KEY

# ─── GoHighLevel Webhook URLs ────────────────────────────────────────────────
#
# To get the URLs: GHL → Automations → Workflows → (your workflow) → Webhook Trigger → Copy URL

GHL_CONTACT_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR_CONTACT_WEBHOOK_ID
GHL_CLAIM_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR_CLAIM_WEBHOOK_ID
